ADMIN_PASSWORD=change_me

# ---- Cloudinary (free image hosting: https://cloudinary.com) ----
# Found on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---- CORS ----
# Public frontend origin (comma-separated for multiple). localhost is always allowed.
CLIENT_ORIGIN=https://anushanga-munasinghe.vercel.app

# ---- Server ----
PORT=5000

# ---- Password reset email (Gmail SMTP) ----
# SMTP_PASS must be a Google App Password (16 chars), not your account password:
# https://myaccount.google.com/apppasswords
SMTP_USER=you@gmail.com
SMTP_PASS=pwbn xrtf rrjr osql
# Where reset codes are sent (defaults to SMTP_USER).
